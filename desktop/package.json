{
  "name": "incus-console-desktop",
  "productName": "Incus Console",
  "version": "26.11.10",
  "description": "A desktop and web console for Incus by your friends at OpenRDS",
  "license": "Apache-2.0",
  "author": "OpenRDS",
  "homepage": "https://github.com/openrds-io/incus-console",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "python": "node scripts/bundle-python.mjs",
    "vendor-xterm": "node scripts/vendor-xterm.mjs",
    "stamp": "node scripts/stamp-commit.mjs",
    "dist": "npm run python && npm run stamp && electron-builder --publish never",
    "dist:dir": "npm run python && npm run stamp && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "electron": "^45.3.3",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "io.openrds.incus-console",
    "productName": "Incus Console",
    "artifactName": "incus-console-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "server/app",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      },
      {
        "from": "python-dist",
        "to": "python"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE.md",
        "to": "NOTICE.md"
      }
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "System",
      "maintainer": "OpenRDS"
    }
  }
}
